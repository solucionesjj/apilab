meta {
  name: UpdateProduct
  type: graphql
  seq: 5
}

post {
  url: {{urlGraphql}}/graphql
  body: graphql
  auth: inherit
}

body:graphql {
  mutation {
    updateProducto(
      id: 8, 
      precio: 1800.00, 
      descripcion: "Laptop de altisima gama - Oferta"
    ) {
      id
      nombre
      precio
      fechaActualizacion
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
