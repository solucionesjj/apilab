meta {
  name: CreateProduct
  type: graphql
  seq: 3
}

post {
  url: {{urlGraphql}}/graphql
  body: graphql
  auth: inherit
}

body:graphql {
  mutation {
    createProducto(
      nombre: "Laptop Gamer x1",
      descripcion: "Laptop de alta gama",
      precio: 1500.00
    ) {
      id
      nombre
      precio
      fechaCreacion
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
